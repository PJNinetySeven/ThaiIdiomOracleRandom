            },
            {
                id: 10,
                idiom: "จับปลาสองมือ",
                category: "การตัดสินใจ & โฟกัส",
                meaning: "พยายามทำสองอย่างพร้อมๆ กัน ซึ่งอาจทำให้ไม่ได้ผลดีสักอย่าง",
                warning: "คุณกำลังพยายามทำหลายอย่างมากเกินไปในเวลาเดียวกัน ให้เลือกเป้าหมายสำคัญที่สุดเพียงอย่างเดียวแล้วโฟกัสให้จบก่อน"
            }
        ];

        let isFlipped = false;
        let isAnimating = false;

        function drawCard() {
            if (isAnimating) return;
            isAnimating = true;

            const card = document.getElementById('oracleCard');
            const drawBtn = document.getElementById('drawBtn');

            // ถ้าไพ่เปิดอยู่ ให้พลิกกลับก่อน แล้วค่อยสุ่ม
            if (isFlipped) {
                card.classList.remove('is-flipped');
                isFlipped = false;
                
                setTimeout(() => {
                    pickRandomData();
                    card.classList.add('is-flipped');
                    isFlipped = true;
                    isAnimating = false;
                }, 800);
            } else {
                pickRandomData();
                card.classList.add('is-flipped');
                isFlipped = true;
                setTimeout(() => { isAnimating = false; }, 800);
            }
        }

        function pickRandomData() {
            const randomIndex = Math.floor(Math.random() * oracleDeck.length);
            const data = oracleDeck[randomIndex];

            document.getElementById('cardNo').innerText = `#${String(data.id).padStart(2, '0')}`;
            document.getElementById('cardCategory').innerText = data.category;
            document.getElementById('cardTitle').innerText = data.idiom;
            document.getElementById('cardMeaning').innerText = `"${data.meaning}"`;
            document.getElementById('cardWarning').innerText = data.warning;
        }
    </script>
